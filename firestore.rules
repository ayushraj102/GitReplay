rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Entity validation helpers
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && data.updatedAt is timestamp;
    }

    function isValidCommitAnnotation(data, userId) {
      return data.keys().hasAll(['uid', 'repoId', 'commitSha', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'repoId', 'commitSha', 'note', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.repoId is string && isValidId(data.repoId)
        && data.commitSha is string && data.commitSha.size() >= 4 && data.commitSha.size() <= 64 && isValidId(data.commitSha)
        && data.note is string && data.note.size() <= 4000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedRepository(data, userId) {
      return data.keys().hasAll([
          'uid', 'repoId', 'owner', 'name', 'description',
          'defaultBranch', 'primaryLanguage', 'commits', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'repoId', 'owner', 'name', 'description',
          'defaultBranch', 'primaryLanguage', 'commits', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.repoId is string && isValidId(data.repoId)
        && data.owner is string && data.owner.size() >= 1 && data.owner.size() <= 100
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.defaultBranch is string && data.defaultBranch.size() >= 1 && data.defaultBranch.size() <= 64
        && data.primaryLanguage is string && data.primaryLanguage.size() >= 1 && data.primaryLanguage.size() <= 64
        && data.commits is list && data.commits.size() >= 1 && data.commits.size() <= 200 && data.commits[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['uid', 'repoId', 'role', 'persona', 'modelUsed', 'text', 'createdAt'])
        && data.keys().hasOnly(['uid', 'repoId', 'role', 'persona', 'modelUsed', 'commitSha', 'text', 'createdAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.repoId is string && isValidId(data.repoId)
        && data.role in ['user', 'model']
        && data.persona in ['general', 'architect', 'mentor', 'fast']
        && data.modelUsed is string && data.modelUsed.size() >= 1 && data.modelUsed.size() <= 64
        && (!('commitSha' in data) || (data.commitSha is string && data.commitSha.size() <= 64))
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 16000
        && data.createdAt is timestamp;
    }

    function isValidAICacheEntry(data, userId) {
      return data.keys().hasAll([
          'uid', 'cacheId', 'repoId', 'commitSha', 'mode',
          'model', 'promptVersion', 'normalizedQuestion', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'cacheId', 'repoId', 'commitSha', 'mode',
          'model', 'promptVersion', 'normalizedQuestion',
          'responseText', 'analysisData', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.cacheId is string && isValidId(data.cacheId)
        && data.repoId is string && isValidId(data.repoId)
        && data.commitSha is string && data.commitSha.size() >= 4 && data.commitSha.size() <= 64 && isValidId(data.commitSha)
        && data.mode in ['analysis', 'ask']
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 64
        && data.promptVersion is string && data.promptVersion.size() >= 1 && data.promptVersion.size() <= 32
        && data.normalizedQuestion is string && data.normalizedQuestion.size() <= 1000
        && (!('responseText' in data) || (data.responseText is string && data.responseText.size() <= 32000))
        && (!('analysisData' in data) || (data.analysisData is map))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      // Private PII subcollection (email)
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'account' && isOwner(userId);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && docId == 'account'
          && isVerifiedOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      // Commit annotations subcollection
      match /annotations/{annotationId} {
        allow get: if isValidId(userId) && isValidId(annotationId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(annotationId)
          && isVerifiedOwner(userId)
          && isValidCommitAnnotation(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(annotationId)
          && isVerifiedOwner(userId)
          && isValidCommitAnnotation(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().repoId == existing().repoId
          && incoming().commitSha == existing().commitSha
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['note', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(annotationId) && isVerifiedOwner(userId);
      }

      // User-saved repositories subcollection
      match /savedRepos/{repoId} {
        allow get: if isValidId(userId) && isValidId(repoId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(repoId)
          && isVerifiedOwner(userId)
          && isValidSavedRepository(incoming(), userId)
          && incoming().repoId == repoId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(repoId)
          && isVerifiedOwner(userId)
          && isValidSavedRepository(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().repoId == existing().repoId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['description', 'commits', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(repoId) && isVerifiedOwner(userId);
      }

      // Multi-turn Gemini chat history subcollection
      match /chatMessages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(messageId)
          && isVerifiedOwner(userId)
          && isValidChatMessage(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(messageId) && isVerifiedOwner(userId);
      }

      // Cloud-synced AI response cache subcollection
      match /aiCache/{cacheId} {
        allow get: if isValidId(userId) && isValidId(cacheId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(cacheId)
          && isVerifiedOwner(userId)
          && isValidAICacheEntry(incoming(), userId)
          && incoming().cacheId == cacheId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(cacheId)
          && isVerifiedOwner(userId)
          && isValidAICacheEntry(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().cacheId == existing().cacheId
          && incoming().repoId == existing().repoId
          && incoming().commitSha == existing().commitSha
          && incoming().mode == existing().mode
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['model', 'promptVersion', 'normalizedQuestion', 'responseText', 'analysisData', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(cacheId) && isVerifiedOwner(userId);
      }
    }
  }
}
