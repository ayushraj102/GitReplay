{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII such as user email address",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "CommitAnnotation": {
      "title": "CommitAnnotation",
      "description": "Developer architectural review annotation for a specific commit",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "repoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commitSha": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "repoId", "commitSha", "note", "createdAt", "updatedAt"]
    },
    "SavedRepository": {
      "title": "SavedRepository",
      "description": "User-imported GitHub repository or git log timeline (up to 200 commit metadata entries)",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "repoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "primaryLanguage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "commits": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "repoId",
        "owner",
        "name",
        "description",
        "defaultBranch",
        "primaryLanguage",
        "commits",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn Gemini chatbot message persisted per commit thread",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "repoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "persona": {
          "type": "string",
          "enum": ["general", "architect", "mentor", "fast"]
        },
        "modelUsed": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "commitSha": {
          "type": "string",
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "repoId", "role", "persona", "modelUsed", "text", "createdAt"]
    },
    "AICacheEntry": {
      "title": "AICacheEntry",
      "description": "Cached AI response keyed by repo, commit SHA, mode, model, prompt version, and normalized question",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "cacheId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "repoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "commitSha": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mode": {
          "type": "string",
          "enum": ["analysis", "ask"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "normalizedQuestion": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "responseText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32000
        },
        "analysisData": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "cacheId",
        "repoId",
        "commitSha",
        "mode",
        "model",
        "promptVersion",
        "normalizedQuestion",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile document keyed by Firebase Auth UID"
    },
    "/users/{userId}/private/{docId}": {
      "schema": {
        "$ref": "#/entities/UserPrivateInfo"
      },
      "description": "Private PII subcollection strictly isolated to the owner"
    },
    "/users/{userId}/annotations/{annotationId}": {
      "schema": {
        "$ref": "#/entities/CommitAnnotation"
      },
      "description": "Architectural review notes per commit authored by the user"
    },
    "/users/{userId}/savedRepos/{repoId}": {
      "schema": {
        "$ref": "#/entities/SavedRepository"
      },
      "description": "Custom imported GitHub repositories and raw git log timelines saved by the user"
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Multi-turn Gemini chatbot conversation history for the user"
    },
    "/users/{userId}/aiCache/{cacheId}": {
      "schema": {
        "$ref": "#/entities/AICacheEntry"
      },
      "description": "Cloud-synced AI response cache per user"
    }
  }
}
